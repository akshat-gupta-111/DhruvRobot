# ============================================================
# DhruvOrin Standalone Environment Configuration
# ============================================================

# --- HARDWARE & AUDIO ---
CAMERA_INDEX=0
AUDIO_ENABLED=true
TTS_VOICE=en-IN-NeerjaNeural

# --- LLM REASONING BACKEND ---
# Options: "ollama" (for Jetson local model) or "azure"
LLM_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:1.5b

# --- MOONDREAM VISION BACKEND ---
# Options: "ollama" (local Jetson OR Kaggle Ngrok tunnel) or "cloud"
MOONDREAM_BACKEND=ollama

# If using Kaggle Trigger for Moondream, set your Ngrok URL:
# Example: NGROK_BASE_URL=https://xxxx-xx-xx-xx.ngrok-free.app
NGROK_BASE_URL=

# If using Moondream Cloud API (MOONDREAM_BACKEND=cloud):
MOONDREAM_API_KEY=

# Auto-trigger Kaggle notebook when launching main.py (true/false)
AUTO_TRIGGER_KAGGLE=false

# --- AZURE OPENAI (Optional, only needed if LLM_BACKEND=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-12-01-preview
